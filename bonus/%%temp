#include "cub3_images.h"
#include "../utils/utils.h"
#include <stdio.h>
#include <stdlib.h>
#include "../garbage_collector/garbage_collector.h"
#include <string.h>
#include <fcntl.h>
#include <unistd.h>

static int init_cub3_image(t_cub3_image *img, char *first_line)
{
    char **attr;
    
    if (!first_line || !*first_line || strlen(first_line) < 9)
        return (0);
    attr = ft_split(first_line, ':', TEMPORARY);
    if (!attr[2] || !attr[2][0])
        return (0);
    img->width = atoi(attr[1]);
    img->height = atoi(attr[2]);
    if (!(img->width) || !(img->height))
        return (0);
    return (1);
}

static int write_line_to_image(char *line, t_cub3_image *img, int stat)
{
    static int counter = 0;
    int line_counter;
    char **parsed_line;

    if (stat == RESET)
    {
        counter = 0;
        return (RESET);
    }
    parsed_line = ft_split(line, '.', TEMPORARY);
    line_counter = 0;
    while (parsed_line[line_counter])
    {
        img->image[counter] = (int)strtol(parsed_line[line_counter], NULL, 16);
        counter++;
        line_counter++;
    }
    return (1);
}

static char	*extract_line(char *start, char **next_start)
{
	char	*end;
	char	*line_copy;
	int		len;

	end = start;
	while (*end && *end != '\n')
		end++;
	len = end - start;
	line_copy = alloc(len + 1, TEMPORARY);
	memcpy(line_copy, start, len);
	line_copy[len] = '\0';
	if (*end == '\n')
		*next_start = end + 1;
	else
		*next_start = end;
	return (line_copy);
}

static int read_cub3_image_content(t_cub3_image *img, char *content)
{
	char	*line_start;
	char	*line_copy;
	int		line_counter;

	img->image = alloc(img->height * img->width * sizeof(int), STATIC);
	line_start = content;
	line_counter = img->height;
	while (line_counter-- && *line_start)
	{
		line_copy = extract_line(line_start, &line_start);
		if (!line_copy || strlen(line_copy) < 8)
			return (0);
		write_line_to_image(line_copy, img, CONTINUE);
	}
	write_line_to_image(NULL, NULL, RESET);
	return (1);
}

static char	*append_buffer(char *content, char *buffer, int total, int bytes)
{
	char	*new_content;
	char	*old_content;

	new_content = malloc(total + bytes + 1);
	if (total > 0)
		memcpy(new_content, content, total);
	memcpy(new_content + total, buffer, bytes);
	new_content[total + bytes] = '\0';
	old_content = content;
	if (old_content)
		free(old_content);
	return (new_content);
}

static char *read_entire_file(char *path)
{
	int		fd;
	char	*content;
	char	buffer[4096];
	int		bytes_read;
	int		total_size;

	fd = open(path, O_RDONLY);
	if (fd < 0)
		return (NULL);
	content = malloc(1);
	content[0] = '\0';
	total_size = 0;
	while (1)
	{
		bytes_read = read(fd, buffer, 4096);
		if (bytes_read <= 0)
			break;
		content = append_buffer(content, buffer, total_size, bytes_read);
		total_size += bytes_read;
	}
	close(fd);
	return (content);
}

static char	*parse_first_line(char *content, char **rest)
{
	char	*first_line_end;
	char	*first_line;
	int		len;

	first_line_end = content;
	while (*first_line_end && *first_line_end != '\n')
		first_line_end++;
	len = first_line_end - content;
	first_line = alloc(len + 1, TEMPORARY);
	memcpy(first_line, content, len);
	first_line[len] = '\0';
	if (*first_line_end == '\n')
		*rest = first_line_end + 1;
	else
		*rest = first_line_end;
	return (first_line);
}

t_cub3_image create_image(char *path)
{
	char			*file_content;
	char			*first_line;
	char			*rest;
	t_cub3_image	new_image;
	t_cub3_image	empty;

	empty = (t_cub3_image){NULL, 0, 0};
	file_content = read_entire_file(path);
	if (!file_content)
		return (printf("err: cub3_image missing\n"), empty);
	first_line = parse_first_line(file_content, &rest);
	if (!init_cub3_image(&new_image, first_line))
		return (free(file_content), printf("err: Wrong type of input\n"), empty);
	if (!read_cub3_image_content(&new_image, rest))
		return (free(file_content), printf("err: Wrong type of input\n"), empty);
	free(file_content);
	return (new_image);
}
